# Hidden Doors corporate website
# Prepared for serving the static site directly from the production VPS.
# Do not enable this site block until the server directory exists.
#
# Expected release layout:
#   /srv/hidden-doors/releases/<git-sha>/
#   /srv/hidden-doors/current -> /srv/hidden-doors/releases/<git-sha>

www.hidden-doors.ru {
    redir https://hidden-doors.ru{uri} permanent
}

hidden-doors.ru {
    root * /srv/hidden-doors/current
    encode zstd gzip

    # Preserve the legacy URL confirmed before migration.
    @legacy_hiddendoors path /hiddendoors /hiddendoors/
    redir @legacy_hiddendoors /hidden-doors/ 301

    # Long cache for fingerprinted/media assets.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Shorter cache for top-level CSS/JS that currently use query-string versions.
    @static path *.css *.js
    header @static Cache-Control "public, max-age=86400"

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    try_files {path} {path}/index.html
    file_server

    handle_errors {
        @not_found expression {http.error.status_code} == 404
        rewrite @not_found /404.html
        file_server
    }
}
